# ===========================================================================
# ShipSprint edge proxy
#
# Terminates TLS and routes to the Next.js app. Replaces the subdomain logic
# that previously lived in middleware.ts, which could not obtain certificates
# for customer custom domains at all.
#
# Two certificate strategies:
#
#   1. Free subdomains (slug.shipsprint.site)
#      ONE wildcard certificate covers every subdomain. A single DNS A record
#      plus one cert, so unlimited free subdomains cost nothing per site.
#
#   2. Customer custom domains
#      On-demand TLS. Caddy asks /api/caddy/ask before requesting a certificate;
#      that endpoint only authorizes a domain that a paying customer has
#      actually connected to a published site. This is the open-source,
#      zero-cost alternative to Cloudflare for SaaS, which is an Enterprise
#      feature costing ~$200/month.
#
# Required DNS:
#   shipsprint.site          A     <server-ip>
#   *.shipsprint.site        A     <server-ip>
#
# Required env (see .env.example):
#   CNAME_TARGET_HOST=cname.shipsprint.site   (itself a wildcard * A record)
#   ACME_CONTACT_EMAIL=ops@yourdomain.com
# ===========================================================================

{
	# Contact address embedded in the ACME account. Without it, expiry notices
	# are undeliverable and a renewal failure is silent until the cert expires.
	email {$ACME_CONTACT_EMAIL}

	# Use the staging CA while wiring up a new deployment. Staging certificates
	# are untrusted, so remove this line once issuance works.
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

{
	# Shared snippets.
	snippet {
		encode zstd gzip

		# Suppress the version banner.
		log {
			output stdout
			format json
		}
	}

	# Never cache authenticated responses. The dashboard must never be served
	# from a cache, and the app already sets correct headers for public pages.
	snippet no_cache {
		header Cache-Control "no-store, no-cache, must-revalidate"
	}
}

# --- Application host ------------------------------------------------------
shipsprint.site, www.shipsprint.site {
	import snippet
	import snippet no_cache

	# Redirect the apex to the canonical host so cookies and canonical URLs are
	# consistent.
	@www host www.shipsprint.site
	redir @www https://shipsprint.site{uri} permanent

	reverse_proxy app:3000

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# --- Free customer subdomains ---------------------------------------------
*.shipsprint.site {
	import snippet

	# One wildcard certificate. Caddy issues and renews it automatically via
	# DNS-01, which requires a DNS provider token (see the tokens block below).
	reverse_proxy app:3000

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# --- Customer custom domains ----------------------------------------------
# `on_demand_tls` makes issuance lazy: a certificate is requested only when a
# hostname is actually requested, and only after /api/caddy/ask authorizes it.
{
	http_port 80
	https_port 443
	on_demand_tls {
		ask http://app:3000/api/caddy/ask
	}
}

*.com, *.net, *.org, *.io, *.app, *.dev, *.co, *.xyz {
	import snippet

	tls {
		on_demand
	}

	# Block obviously-abusive clients before they can trigger issuance attempts.
	@abuse {
		method GET
	}

	reverse_proxy app:3000

	header {
		Strict-Transport-HSTS "max-age=63072000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Customer pages embed their own assets, so the policy is scoped to
		# same-origin plus the configured asset host rather than a strict list.
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}
}

# --- HTTP -> HTTPS ---------------------------------------------------------
http:// {
	import snippet
	redir https://{host}{uri} permanent
}

# ===========================================================================
# DNS provider token
#
# Needed for DNS-01, which is the only challenge that can validate a wildcard
# name. Replace `dns cloudflare` with your provider, and supply the token via
# the environment rather than in this file.
#
#   docker compose exec caddy sh -c \
#     'echo "CF_API_TOKEN=xxx" >> /etc/caddy/.env'
# ===========================================================================
dns cloudflare {
	env CF_API_TOKEN
}
