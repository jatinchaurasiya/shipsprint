# ===========================================================================
# ShipSprint Caddy Edge Proxy (Production)
#
# Terminates TLS and routes to the Next.js app.
# Features:
#   - Automatic Let's Encrypt / ZeroSSL certificate management
#   - Automated HTTP -> HTTPS redirection on port 80 (with ACME challenge solver)
#   - Wildcard certificate for *.ROOT_DOMAIN via Cloudflare DNS-01 challenge
#   - On-demand TLS for custom customer domains with /api/caddy/ask verification
#   - Upstream reverse proxy with preserved host and client IP headers
#   - Modern HTTP/2 and HTTP/3 support
# ===========================================================================

{
	email {$ACME_CONTACT_EMAIL}
	on_demand_tls {
		ask http://app:3000/api/caddy/ask
	}
}

(common) {
	encode zstd gzip
	log {
		output stdout
		format json
	}
}

(no_cache) {
	header Cache-Control "no-store, no-cache, must-revalidate"
}

# --- HTTP Catch-All (Port 80) -> HTTPS Redirection ---
# Caddy's internal ACME solver automatically intercepts /.well-known/acme-challenge/*
# All other HTTP requests are redirected permanently to HTTPS.
http:// {
	redir https://{host}{uri} permanent
}

# --- Main Application & Marketing Dashboard ---
{$ROOT_DOMAIN:shipsprint.site}, www.{$ROOT_DOMAIN:shipsprint.site} {
	import common
	import no_cache

	@www host www.{$ROOT_DOMAIN:shipsprint.site}
	redir @www https://{$ROOT_DOMAIN:shipsprint.site}{uri} permanent

	reverse_proxy app:3000 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# --- Customer Subdomains (*.ROOT_DOMAIN) with Wildcard DNS-01 TLS ---
*.{$ROOT_DOMAIN:shipsprint.site} {
	import common

	tls {
		dns cloudflare {$CF_API_TOKEN}
	}

	reverse_proxy app:3000 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}

	header {
		Strict-Transport-Security "max-age=63072000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# --- On-Demand TLS for Customer Custom Domains ---
:443 {
	import common

	tls {
		on_demand
	}

	reverse_proxy app:3000 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}

	header {
		Strict-Transport-Security "max-age=63072000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://minilytics.chaursiajatin7.workers.dev; font-src 'self' data: https:; connect-src 'self' https: https://minilytics.chaursiajatin7.workers.dev; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https:"
		-Server
	}
}
