# ===========================================================================
# ShipSprint Caddy Edge Proxy (Production)
#
# Terminates TLS and routes to the Next.js app.
# Features:
#   - Automatic Let's Encrypt / ZeroSSL certificate management
#   - On-demand TLS for published subdomains (*.shipsprint.site) & custom domains
#   - Automated HTTP -> HTTPS redirection
#   - Modern HTTP/2 and HTTP/3 support
# ===========================================================================

{
	email {$ACME_CONTACT_EMAIL}
	on_demand_tls {
		ask http://app:3000/api/caddy/ask
	}
}

(common) {
	encode zstd gzip
	log {
		output stdout
		format json
	}
}

(no_cache) {
	header Cache-Control "no-store, no-cache, must-revalidate"
}

# --- Main Application & Dashboard ---
shipsprint.site, www.shipsprint.site {
	import common
	import no_cache

	@www host www.shipsprint.site
	redir @www https://shipsprint.site{uri} permanent

	reverse_proxy app:3000

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# --- On-Demand TLS for Customer Subdomains & Custom Domains ---
:443 {
	import common

	tls {
		on_demand
	}

	reverse_proxy app:3000

	header {
		Strict-Transport-Security "max-age=63072000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}
}
