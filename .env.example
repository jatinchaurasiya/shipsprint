# ---------------------------------------------------------------------------
# ShipSprint environment
#
# Copy to `.env.local` for development. `.env*` is gitignored, so this file is
# the only record of what the app needs.
#
# NOTE: NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time.
# Changing one requires a rebuild, not just a restart.
#
# See lib/env.ts for the schema that validates these.
# ---------------------------------------------------------------------------

# --- Supabase ---------------------------------------------------------------
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS. Never expose to the browser.
# Used by: /api/track, /api/domains, /api/billing/webhook, /api/upload,
#          and the public site renderer.
SUPABASE_SERVICE_ROLE_KEY=

# --- App URLs ---------------------------------------------------------------
# The apex domain the app is served from, no protocol. Used to build customer
# subdomains (slug.<ROOT_DOMAIN>).
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Absolute origin, used for auth callbacks and billing return URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Dodo Payments ----------------------------------------------------------
# https://dashboard.dodopayments.com
#
# BOTH the API key and the webhook key are REQUIRED in production. A missing
# webhook key disables signature verification, which would let anyone grant
# themselves a paid plan by POSTing to /api/billing/webhook.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=

# `test_mode` or `live_mode`.
DODO_PAYMENTS_ENVIRONMENT=test_mode

# --- Monthly & Yearly Plans (Dodo Payments Product IDs) ---------------------
# Product IDs from Dodo Payments dashboard (e.g. pdt_XXXX).
# Used as fallback or override if not set in the `products` table in Supabase.
# Basic Plan:
DODO_PRODUCT_ID_BASIC_MONTHLY=
DODO_PRODUCT_ID_BASIC_YEARLY=

# Pro Plan:
DODO_PRODUCT_ID_PRO_MONTHLY=
DODO_PRODUCT_ID_PRO_YEARLY=

# Fallback/single-tier plan product IDs (optional):
DODO_PRODUCT_ID_BASIC=
DODO_PRODUCT_ID_PRO=

# --- Cloudflare R2 (uploads) ------------------------------------------------
# https://dash.cloudflare.com -> R2 -> Manage R2 Tokens
# All five are required in production. Without them uploads are disabled
# rather than silently falling back to base64 data URLs in the database.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Custom domain bound to the R2 bucket, e.g. assets.example.com. Optional:
# falls back to the public r2.dev URL when unset.
R2_PUBLIC_DOMAIN=

# --- Custom domains / Caddy (Phase 3) ---------------------------------------
# Hostname Caddy tells users to CNAME their custom domain to.
CNAME_TARGET_HOST=cname.shipsprint.site

# DNS TXT record prefix used to prove domain ownership.
DOMAIN_VERIFY_PREFIX=_shipverify

# Contact address embedded in the ACME account for Let's Encrypt expiry notices.
ACME_CONTACT_EMAIL=

# --- Infrastructure ---------------------------------------------------------
# Redis for rate limiting. Required in production.
REDIS_URL=redis://localhost:6379

# Protects /api/cron/* endpoints from being invoked by anyone.
CRON_SECRET=

# --- Observability ----------------------------------------------------------
# Error tracking. Recommended in production.
SENTRY_DSN=
