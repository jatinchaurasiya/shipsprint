{
  "name": "shipsprint",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run build",
    "db:types": "supabase gen types typescript --linked > types/database.generated.ts",
    "db:migrate": "supabase migration up --linked",
    "db:reset": "supabase db reset --linked",
    "db:diff": "supabase db diff --linked",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:sync": "node scripts/db-sync.mjs",
    "db:apply": "node scripts/db-sync.mjs --apply",
    "db:validate": "python scripts/validate_schema.py"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.109.0",
    "clsx": "^2.1.1",
    "dodopayments": "^2.49.0",
    "ioredis": "^6.0.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.42.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "pg": "^8.23.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
